# ATHANG IMPEX - Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.

# Supabase Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Initial Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_EMAIL=info@athangimpex.in
ADMIN_BOOTSTRAP_PASSWORD=your-secure-admin-password-here

# Site URL for callbacks & metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Email Notification (Resend / SMTP)
EMAIL_FROM=info@athangimpex.in
RESEND_API_KEY=

# Contact Email Override (Public)
NEXT_PUBLIC_CONTACT_EMAIL=info@athangimpex.in
